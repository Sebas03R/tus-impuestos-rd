# ---------------------------------------------------------------------------
# Tus Impuestos RD — variables de entorno. Copie a `.env` y complete.
# NUNCA suba `.env` al repositorio.
# ---------------------------------------------------------------------------

# Entorno: development | test | production
APP_ENV=development

# --- Base de datos -----------------------------------------------------------
# Pipeline (Python, rol con permisos de escritura). Local: docker compose.
DATABASE_URL=postgresql+psycopg://tirds:tirds_local_only@localhost:54330/tirds
# Web (Next.js, rol web_app con lectura + escrituras mínimas). En Supabase use el pooler en
# MODO SESIÓN (puerto 5432) con el usuario web_app.<project_ref>; el modo transaccional (6543)
# pierde respuestas con el pipelining del driver `postgres`.
DATABASE_URL_WEB=postgres://web_app:web_app_local_only@localhost:54330/tirds
# Solo para docker compose local
POSTGRES_DB=tirds
POSTGRES_USER=tirds
POSTGRES_PASSWORD=tirds_local_only
DB_PORT=54330
WEB_APP_DB_PASSWORD=web_app_local_only

# --- Sincronización -----------------------------------------------------------
# Inicio de la ventana de datos (el plan gratuito de Supabase tiene 500 MB).
SYNC_SINCE=2025-01-01
REQUESTS_PER_MINUTE=50
HTTP_USER_AGENT="TusImpuestosRD-bot/0.1 (+https://tus-impuestos-rd.netlify.app/acerca)"

# --- Snapshots crudos (opcional). Sin esto se guardan en disco (data/snapshots).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SNAPSHOT_BUCKET=raw-snapshots

# --- Alertas operativas (GitHub Actions las provee automáticamente)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# --- Web ----------------------------------------------------------------------
SITE_URL=http://localhost:3000
# Mínimo 32 caracteres aleatorios: openssl rand -base64 48
SESSION_SECRET=
# Botón "Reejecutar sincronización" del panel (token fino con permiso actions:write)
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=<propietario>/<repositorio>

# --- IA opcional (Gemini, plan gratuito). Sin clave, la IA queda desactivada.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_REQUEST_LIMIT=200
